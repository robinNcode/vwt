// =============================================================================
//  VWT — FRONTEND PRODUCTION PIPELINE  (React + Vite)
//  Publishes the production build to voltwavebd.com (main domain) over FTP.
// -----------------------------------------------------------------------------
//  Flow: checkout latest commit → npm ci → npm run build (Vite, production) →
//        FTP-upload the built dist/ into the main-domain docroot (public_html/).
//
//  Deploy is done over FTP using the "Publish Over FTP" Jenkins plugin — NO SSH.
//  The build runs entirely on the agent in production mode; only static, already
//  -built assets are shipped. The server does nothing but receive files.
//
//  ── ONE-TIME JENKINS SETUP ────────────────────────────────────────────────
//  1) Credential for GitHub checkout (Manage Jenkins → Credentials):
//        ID: github-https   Kind: Username with password
//        User: robinNcode   Pass: <GitHub PAT from secrets/general.txt>
//
//  2) FTP server config (Manage Jenkins → System → "Publish over FTP"):
//        Name:        vwt-ftp          (this exact name goes in FTP_CONFIG below)
//        Hostname:    voltwavebd.com
//        Port:        21               (or 990 for FTPS — set in the plugin)
//        Username:    <cPanel FTP user>
//        Password:    <cPanel FTP pass>
//        Remote root: /                (the FTP user's home; remoteDirectory
//                                       below is resolved relative to this)
//     Use "Test Configuration" in that screen to confirm it connects.
//
//  FRONTEND_DIR is the docroot RELATIVE TO the FTP remote root above.
// =============================================================================

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timestamps()
        disableConcurrentBuilds()
    }

    // Auto-deploy the latest commit. Prefer a GitHub webhook; poll is a fallback.
    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        // Name of the "Publish over FTP" server config created in Jenkins → System.
        FTP_CONFIG   = 'vwt-ftp'
        // Main-domain (voltwavebd.com) docroot, RELATIVE to the FTP remote root.
        FRONTEND_DIR = 'public_html'
    }

    stages {

        stage('Checkout Latest Commit') {
            steps {
                // Shallow, single-branch, no-tags checkout of the latest commit.
                // The repo has a large history (148+ MB) with a bad object on the
                // remote; a full clone aborts with "fetch-pack: invalid index-pack".
                // depth:1 fetches only the tip snapshot, avoiding that history.
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/robinNcode/vwt.git',
                        credentialsId: 'github-https',
                        refspec: '+refs/heads/master:refs/remotes/origin/master'
                    ]],
                    extensions: [
                        [$class: 'CloneOption', shallow: true, depth: 1, noTags: true, honorRefspec: true, timeout: 30],
                        [$class: 'CheckoutOption', timeout: 30]
                    ]
                ])
                bat 'git rev-parse --short HEAD'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build (Vite / production)') {
            steps {
                // frontend/.env.production is picked up automatically by Vite,
                // so the bundle targets https://api.voltwavebd.com/api/v1
                dir('frontend') {
                    bat 'npm run build'
                }
            }
        }

        stage('Deploy (FTP)') {
            steps {
                // Upload the built assets into the docroot. Vite emits content-
                // hashed filenames, so stale old assets are harmless; we leave
                // cleanRemote=false to avoid wiping anything else in public_html.
                ftpPublisher(
                    masterNodeName: '',
                    paramPublish: null,
                    failOnError: true,
                    continueOnError: false,
                    alwaysPublishFromMaster: true,
                    publishers: [[
                        configName: "${env.FTP_CONFIG}",
                        transfers: [[
                            sourceFiles:      'frontend/dist/**',
                            removePrefix:     'frontend/dist',
                            remoteDirectory:  "${env.FRONTEND_DIR}",
                            cleanRemote:      false,
                            flatten:          false,
                            makeEmptyDirs:    true,
                            asciiMode:        false,
                            remoteDirectorySDF: false
                        ]]
                    ]]
                )
            }
        }
    }

    post {
        success { echo '✅ Frontend published — https://voltwavebd.com' }
        failure { echo '❌ Frontend deploy failed — check the log above' }
        always  { cleanWs() }
    }
}
