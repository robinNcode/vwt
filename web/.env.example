# Server-only Laravel API root, including the version prefix.
# Public server components call this wrapper; never expose it with NEXT_PUBLIC_*.
API_URL=http://127.0.0.1:8000/api/v1

# Canonical site origin used for metadata, JSON-LD, sitemap, and share URLs.
SITE_URL=http://localhost:3000

# Browser-side API base. Defaults to /api/v1 and is proxied to API_URL by next.config.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional backend origin for relative media paths. Leave blank when media is
# served from the same origin through the /storage and /uploads rewrites.
NEXT_PUBLIC_SERVER_URL=

# Optional Facebook app id for the Messenger share fallback.
NEXT_PUBLIC_MESSENGER_APP_ID=
