# Server-only Laravel API root, including the version prefix.
API_URL=http://127.0.0.1:8083/api/v1

# Canonical site origin used for metadata, JSON-LD, sitemap, and share URLs.
SITE_URL=http://localhost:3000

# Browser-side API base. This is proxied to API_URL by next.config.mjs.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend origin used to resolve relative product and service media paths.
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:8083

# Optional Facebook app id for the Messenger share fallback.
NEXT_PUBLIC_MESSENGER_APP_ID=
